# Caso 2 — Regla de detección de DNS tunneling

# (a) Control de acceso en el gateway: solo los hosts del laboratorio pueden
#     consultar al DNS interno (192.168.50.53). Todo lo demás se descarta.
table inet filter {
    chain forward {
        type filter hook forward priority 0; policy drop;
        ip saddr 192.168.50.0/24 ip daddr 192.168.50.53 udp dport 53 accept
    }
}

# (b) Firma de detección por inspección de contenido (Suricata-like).
#     El primer byte de dns.query es la longitud de la primera etiqueta:
#     si supera 30 caracteres, se trata de una etiqueta atípica (tunelización).
#     La entropía alta se evalúa fuera de línea (ver analizar_caso02.py).

# alert udp any any -> 192.168.50.53 53 \
#   (msg:"Posible DNS tunneling - etiqueta larga"; \
#    dns.query; byte_test:1,>,30,0; \
#    sid:1000002; rev:1; classtype:trojan-activity;)

# (c) Regla complementaria: alertar por volumen anómalo de consultas por host
#     (más de N consultas/segundo hacia el DNS interno).
# alert dns any any -> 192.168.50.53 53 \
#   (msg:"Volumen DNS anómalo"; threshold: type both, track by_src, count 20, seconds 1; \
#    sid:1000003; rev:1;)
